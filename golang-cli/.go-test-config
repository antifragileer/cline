# Go Test Configuration
# This file contains optimized test settings for the project
# Source this file or use the values in your environment

# Test parallelism - adjust based on your CPU cores
GO_TEST_PARALLEL=4

# Test timeout settings
GO_TEST_TIMEOUT=10m
GO_INTEGRATION_TIMEOUT=5m
GO_E2E_TIMEOUT=10m

# Build cache settings
GO_BUILD_CACHE=$(go env GOCACHE)
GO_MOD_CACHE=$(go env GOMODCACHE)

# Memory limits for test processes (prevents OOM)
GO_TEST_MEM_LIMIT=4G

# Verbose output (set to 1 for verbose)
GO_TEST_VERBOSE=1

# Race detector (disabled by default for speed, enable for CI)
GO_TEST_RACE=0